name: CI

on:
  pull_request:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  build:
    name: build (all subprojects)
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up JDK
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "{{java_version_daemon}}"

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4

      # `./gradlew build` is the pre-merge gate: it compiles, tests
      # (:common:test — the Tier-1 suite), and assembles EVERY subproject.
      # Per-loader builds (:fabric:build / :neoforge:build) under-test the
      # scaffold — they skip :common's own jar and tests.
      - name: Build
        run: ./gradlew build --stacktrace

      - name: Upload jars
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: {{modid}}-jars
          path: "*/build/libs/*.jar"
          if-no-files-found: ignore
