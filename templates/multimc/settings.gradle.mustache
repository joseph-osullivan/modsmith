// Root settings file for a multi-MC × multi-loader scaffold.
//
// One :common subproject holds pure-Java (MC-agnostic) shared code.
// Each MC line gets its own :versions:<mc>:common, :versions:<mc>:fabric,
// and :versions:<mc>:neoforge subprojects. Per-MC pins live in
// gradle.properties using the <key>_<mc_suffix> scheme (e.g.
// `neoforge_version_26_1_2`); each subproject reads its own row via
// project.findProperty(...).

pluginManagement {
    repositories {
        gradlePluginPortal()
        mavenCentral()
        maven {
            name = 'NeoForged'
            url = uri('https://maven.neoforged.net/releases')
        }
        exclusiveContent {
            forRepository {
                maven {
                    name = 'Fabric'
                    url = uri('https://maven.fabricmc.net/')
                }
            }
            filter {
                includeGroupAndSubgroups('net.fabricmc')
                includeGroup('fabric-loom')
            }
        }
    }
}

plugins {
    id 'org.gradle.toolchains.foojay-resolver-convention' version '1.0.0'
}

rootProject.name = '{{modid}}'

include('common')
{{#mc_versions}}
include('versions:{{mc_version}}:common')
{{#has_fabric}}include('versions:{{mc_version}}:fabric'){{/has_fabric}}
{{#has_neoforge}}include('versions:{{mc_version}}:neoforge'){{/has_neoforge}}
{{/mc_versions}}
