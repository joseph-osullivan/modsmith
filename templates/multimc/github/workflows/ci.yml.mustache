name: CI

on:
  pull_request:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  build:
    name: build (${{ matrix.target.mc }} / ${{ matrix.target.loader }})
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        target:
{{#mc_versions}}
{{#has_fabric}}
          - mc: "{{mc_version}}"
            loader: fabric
            java: "{{java_version}}"
            subproject: ":versions:{{mc_version}}:fabric"
{{/has_fabric}}
{{#has_neoforge}}
          - mc: "{{mc_version}}"
            loader: neoforge
            java: "{{java_version}}"
            subproject: ":versions:{{mc_version}}:neoforge"
{{/has_neoforge}}
{{/mc_versions}}

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up JDK ${{ matrix.target.java }}
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: ${{ matrix.target.java }}

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4

      - name: Build ${{ matrix.target.mc }} ${{ matrix.target.loader }}
        run: ./gradlew ${{ matrix.target.subproject }}:build --stacktrace

      - name: Upload artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: {{modid}}-${{ matrix.target.mc }}-${{ matrix.target.loader }}-jar
          path: versions/${{ matrix.target.mc }}/${{ matrix.target.loader }}/build/libs/*.jar
          if-no-files-found: ignore
