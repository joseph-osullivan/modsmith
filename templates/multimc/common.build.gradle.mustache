// Top-level :common — pure Java only. NO Minecraft, NO loader runtime.
//
// This module compiles against vanilla Java SDK plus whatever third-party
// libraries you add explicitly. It MUST NOT import anything from
// net.minecraft.*, net.fabricmc.*, or net.neoforged.*. The doctor skill
// hard-fails on any such import here.
//
// Use this module for MC-agnostic logic: math, codecs, state machines,
// pure data structures, business rules — anything that doesn't actually
// need to reach into the MC API. Code that needs MC types belongs in
// versions/<mc>/common/ instead (one copy per MC line, because MC APIs
// diverge across versions).
//
// Java toolchain: set to `java_version_shared` from gradle.properties,
// which is the *lowest* Java version across the targeted MC lines. Every
// per-MC line consumes :common's bytecode, and an older JVM (e.g. the
// Java-21 line) cannot load classes built for a newer one (Java 25) —
// newer JVMs run older bytecode, never the reverse.
plugins {
    id 'java-library'
}

def sharedJava = (project.findProperty('java_version_shared') as String).toInteger()

java {
    toolchain {
        languageVersion = JavaLanguageVersion.of(sharedJava)
    }
    withSourcesJar()
}

tasks.withType(JavaCompile).configureEach {
    options.release.set(sharedJava)
}

base {
    archivesName = "${project.findProperty('modid')}-common"
}

dependencies {
    // Tier-1 unit tests (JUnit 5) — pure-JVM tests over common code, run via
    // `./gradlew :common:test`. This wiring ships with the scaffold so the
    // red-first test workflow works out of the box.
    testImplementation platform('org.junit:junit-bom:5.11.4')
    testImplementation 'org.junit.jupiter:junit-jupiter'
    testRuntimeOnly    'org.junit.platform:junit-platform-launcher'
}

tasks.named('test', Test) {
    useJUnitPlatform()
}

// Publish source + resource directories so per-MC subprojects can pull
// :common's code in directly (same trick the single-MC scaffold uses).
configurations {
    commonJava {
        canBeResolved = false
        canBeConsumed = true
    }
    commonResources {
        canBeResolved = false
        canBeConsumed = true
    }
}

artifacts {
    commonJava sourceSets.main.java.sourceDirectories.singleFile
    commonResources sourceSets.main.resources.sourceDirectories.singleFile
}
