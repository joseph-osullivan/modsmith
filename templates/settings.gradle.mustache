pluginManagement {
    repositories {
        gradlePluginPortal()
        mavenCentral()
        maven {
            name = 'NeoForged'
            url = uri('https://maven.neoforged.net/releases')
        }
        exclusiveContent {
            forRepository {
                maven {
                    name = 'Fabric'
                    url = uri('https://maven.fabricmc.net/')
                }
            }
            filter {
                includeGroupAndSubgroups('net.fabricmc')
                includeGroup('fabric-loom')
            }
        }
    }
}

plugins {
    // Auto-provisions the Java toolchain (resolves java_version from gradle.properties).
    id 'org.gradle.toolchains.foojay-resolver-convention' version '1.0.0'
}

// rootProject.name must match the on-disk folder name (IDEA-317606), but for
// modsmith-scaffolded mods we lock it to the modid so the artifact paths are
// stable regardless of where the user cloned the project.
rootProject.name = '{{modid}}'

include('common')
include('fabric')
include('neoforge')
