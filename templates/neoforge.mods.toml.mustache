modLoader     = "javafml"
loaderVersion = "[1,)"
license       = "{{license}}"
issueTrackerURL = ""

[[mods]]
modId       = "{{modid}}"
# `${file.jarVersion}` is resolved at mod-load time by NeoForge FML from the
# jar manifest — leaving it literal here is intentional and required.
version     = "${file.jarVersion}"
displayName = "{{mod_name}}"
description = '''{{description}}'''
authors     = "{{authors}}"
credits     = ""

[[mixins]]
config = "{{modid}}.mixins.json"

[[dependencies.{{modid}}]]
modId        = "neoforge"
type         = "required"
versionRange = "[{{neoforge_version}},)"
ordering     = "NONE"
side         = "BOTH"

[[dependencies.{{modid}}]]
modId        = "minecraft"
type         = "required"
versionRange = "[{{mc_version}},)"
ordering     = "NONE"
side         = "BOTH"
